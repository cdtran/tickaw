# Runtime
ENVIRONMENT=development
API_PORT=8000
WEB_PORT=5173

# Database and queue
# Legacy internal resource names are retained to preserve existing local data.
# The product name is tickaw; its domain is tickaw.com.
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/data_notebook
REDIS_URL=redis://redis:6379/0

# Object storage (use LocalStack/MinIO locally; S3 in AWS)
OBJECT_STORAGE_BUCKET=data-notebook-dev
MAX_UPLOAD_BYTES=10485760
AWS_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Model provider credentials — choose only the providers you enable
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Model routing. The UI and API should use these stable IDs, never raw provider names.
LLM_DEFAULT_MODEL=qwen-local
LLM_ENABLED_MODELS=qwen-local
QWEN_BASE_URL=http://host.docker.internal:11434/v1
QWEN_MODEL=qwen3:8b
QWEN_TIMEOUT_SECONDS=120

# Optional paid route: add openai-analysis to LLM_ENABLED_MODELS and set an explicit model.
# Prices must match that model's current USD per million tokens; no price defaults.
OPENAI_MODEL=
OPENAI_ALLOW_PAID=false
# OPENAI_MAX_COST_USD=0.10
# OPENAI_MAX_REQUESTS=2
# OPENAI_INPUT_RATE=<reviewed price>
# OPENAI_OUTPUT_RATE=<reviewed price>
OPENAI_MAX_OUTPUT_TOKENS=1024
