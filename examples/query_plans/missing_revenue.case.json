{
  "case_version": 1,
  "id": "missing_revenue",
  "fixture": "sales.fixture.json",
  "questions": [
    "Count rows with missing revenue by region.",
    "How many records in each region have null revenue?"
  ],
  "plan": {
    "plan_version": 2,
    "dimensions": [
      "region"
    ],
    "metrics": [
      {
        "op": "count_rows",
        "alias": "row_count"
      }
    ],
    "filters": [
      {
        "column": "revenue",
        "op": "is_null"
      }
    ],
    "order_by": [],
    "limit": 100,
    "presentation": {"type": "bar"}
  },
  "expected_columns": [
    "region",
    "row_count"
  ],
  "expected_rows": [
    [
      "East",
      1
    ]
  ]
}
