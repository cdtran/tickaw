        "column": "sold_on",
        "op": "gte",
        "value": "2025-01-01"
      },
      {
        "column": "sold_on",
        "op": "lt",
        "value": "2026-01-01"
      }
    ],
    "order_by": [],
    "limit": 100
  },
  "expected_columns": [
    "region",
    "total_revenue"
  ],
  "expected_rows": [
    [
      "East",
      15
    ],
    [
      "North",
      40
    ],
    [
      "West",
      40
    ],
    [
      null,
      7
    ]
  ]
}
